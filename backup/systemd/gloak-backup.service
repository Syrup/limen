[Unit]
Description=gloak backup for Limen
Wants=network-online.target
After=network-online.target
OnFailure=gloak-backup-alert.service

[Service]
Type=oneshot
EnvironmentFile=@LIMEN_HOME@/backup/env
ExecStart=@LIMEN_HOME@/backup/backup.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
