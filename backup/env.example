# Copy this file to env, then chmod 600 env and fill in the values.

GLOAK_BIN="$HOME/limen/backup/bin/gloak"
GLOAK_DIR="$HOME/limen/backup/keys"

# rclone remote, for example r2:limen-backup
GLOAK_REMOTE="CHANGE_ME:limen-backup"
RCLONE_CONFIG="$HOME/.config/rclone/rclone.conf"

COMPOSE_DIR="$HOME/limen"
DB_PATH="$COMPOSE_DIR/auth/data/auth.db"
BUN_BIN="$HOME/.bun/bin/bun"

KEEP_LAST=7
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=0

# Optional failure alerts
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
