# deployment values
.env

# runtime state: passkeys, invites, sessions, signing secret
auth/data/

# backup secrets and keys
backup/env
backup/keys/

# build inputs that are not source
node_modules/

# built by web/ into auth/assets
auth/assets/*.min.js
auth/assets/app.css
auth/assets/vendor.js
auth/assets/webauthn.js

# the gloak binary is built separately
backup/bin/

# tooling caches
worker/.wrangler/
