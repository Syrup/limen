{
	admin off
	auto_https off
	persist_config off
}

:{$LIMEN_PROXY_PORT:8088} {
	bind {$LIMEN_BIND:127.0.0.1}

	map {http.request.host} {target_port} {
		~^p(?P<pnum>[1-9][0-9]{0,4})\.{$LIMEN_DOMAIN}$ ${pnum}
		default none
	}

	@auth host {$LIMEN_AUTH_HOST}
	handle @auth {
		reverse_proxy localhost:{$LIMEN_AUTH_PORT:8099} {
			flush_interval -1
		}
	}

	@invalid vars {target_port} none
	handle @invalid {
		@id header_regexp Accept-Language (?i)^\s*id
		respond @id "Subdomain tidak valid. Format: https://p<port>.{$LIMEN_DOMAIN}" 404
		respond "Invalid subdomain. Format: https://p<port>.{$LIMEN_DOMAIN}" 404
	}

	handle {
		forward_auth localhost:{$LIMEN_AUTH_PORT:8099} {
			uri /verify
			header_up X-Port {target_port}
		}

		reverse_proxy localhost:{target_port} {
			header_up Host localhost
			flush_interval -1
		}
	}

	handle_errors {
		@502 expression {http.error.status_code} == 502
		handle @502 {
			@id header_regexp Accept-Language (?i)^\s*id
			header Content-Type "text/html; charset=utf-8"
			templates {
				root /srv/errors
			}
			respond @id "{{include \"502.html\"}}" 503
			respond "{{include \"502.en.html\"}}" 503
		}
		respond "{http.error.status_code}" {http.error.status_code}
	}

	log {
		output stdout
		format filter {
			wrap console
			fields {
				request>uri query {
					replace token REDACTED
				}
				request>headers>Referer query {
					replace token REDACTED
				}
			}
		}
	}
}
