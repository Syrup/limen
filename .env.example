# Copy this file to .env and adjust the values. Docker Compose reads it
# automatically. Anything left out falls back to the default shown here.

# The zone that serves your apps. Every p<port>.<domain> name is routed through
# the proxy, so a wildcard DNS record must point at the tunnel.
LIMEN_DOMAIN=example.com
LIMEN_AUTH_HOST=auth.example.com

# Ports. The proxy and auth listener stay on loopback.
LIMEN_PROXY_PORT=8088
LIMEN_AUTH_PORT=8099
LIMEN_BIND=127.0.0.1
LIMEN_SSH_PORT=22

# Owner identity shown in the passkey prompt and the invite links.
LIMEN_OWNER_NAME=owner
LIMEN_RP_NAME=Limen

# Timezone used for dates in the dashboard and invite pages.
LIMEN_TZ=UTC

# Limits and retention.
LIMEN_OWNER_TTL_HOURS=24
LIMEN_MAX_GUEST_SESSIONS=20
LIMEN_RATE_LIMIT_MAX=60
LIMEN_AUDIT_RETENTION_DAYS=90
LIMEN_MAX_COOKIE_AGE_DAYS=400

# UID and GID that own auth/data on the host.
LIMEN_UID=1000
LIMEN_GID=1000
