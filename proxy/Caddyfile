{
	admin off
	auto_https off
	persist_config off
}

# Dispatcher: p<port>.{$LIMEN_DOMAIN} -> localhost:<port> (gate via auth-gateway)
#            {$LIMEN_AUTH_HOST}      -> auth-gateway (passkey login/register)
# LIMEN_DOMAIN and LIMEN_AUTH_HOST come from the environment. Compose refuses to
# start without them, so there is no default that could silently be wrong.
:{$LIMEN_PROXY_PORT:8088} {
	bind {$LIMEN_BIND:127.0.0.1}

	map {http.request.host} {target_port} {
		~^p(?P<pnum>[1-9][0-9]{0,4})\.{$LIMEN_DOMAIN}$ ${pnum}
		default none
	}

	@auth host {$LIMEN_AUTH_HOST}
	handle @auth {
		reverse_proxy localhost:{$LIMEN_AUTH_PORT:8099} {
			flush_interval -1
		}
	}

	# This has to be its own handle block. Caddy sorts forward_auth ahead of
	# respond inside one branch, so combining them sends junk hosts to the login
	# gate and returns 302 instead of 404.
	@invalid vars {target_port} none
	handle @invalid {
		@en header_regexp Accept-Language (?i)^\s*en
		respond @en "Invalid subdomain. Format: https://p<port>.{$LIMEN_DOMAIN}" 404
		respond "Subdomain tidak valid. Format: https://p<port>.{$LIMEN_DOMAIN}" 404
	}

	handle {
		forward_auth localhost:{$LIMEN_AUTH_PORT:8099} {
			uri /verify
			header_up X-Port {target_port}
		}

		reverse_proxy localhost:{target_port} {
			header_up Host localhost
			flush_interval -1
		}
	}

	handle_errors {
		@502 expression {http.error.status_code} == 502
		handle @502 {
			@en header_regexp Accept-Language (?i)^\s*en
			header Content-Type "text/html; charset=utf-8"
			templates {
				root /srv/errors
			}
			# 503 instead of 502: Cloudflare replaces a 502 body with its own page,
			# while a 503 body passes through unchanged.
			respond @en "{{include \"502.en.html\"}}" 503
			respond "{{include \"502.html\"}}" 503
		}
		respond "{http.error.status_code}" {http.error.status_code}
	}

	log {
		output stdout
		format filter {
			wrap console
			fields {
				# Invite tokens live in the query string. Keep them out of the logs
				# while still showing that a token was present.
				request>uri query {
					replace token REDACTED
				}
				# The register page links back to /login, so the token also shows
				# up in the Referer header of that navigation.
				request>headers>Referer query {
					replace token REDACTED
				}
			}
		}
	}
}
